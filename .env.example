# CodeMind configuration. Copy to .env and adjust. Never commit a real .env.

# Where Ollama listens. Inference stays on this machine by default.
OLLAMA_BASE_URL=http://localhost:11434

# Model used when a request does not name one. Must already be installed:
#   ollama pull qwen2.5-coder:7b
# Alternatives: qwen2.5-coder:3b (<=8 GB RAM / small GPU), qwen2.5-coder:1.5b (very small),
# qwen2.5-coder:14b (>=16 GB RAM or 12 GB+ VRAM).
OLLAMA_MODEL=qwen2.5-coder:7b

# Per-call HTTP timeout to Ollama (seconds).
OLLAMA_TIMEOUT_SECONDS=120
# Context window requested from Ollama (Ollama's own default of 2048 silently truncates prompts).
OLLAMA_NUM_CTX=8192

# Extra attempts after an invalid model response (regenerate / repair). 0 disables.
MAX_GENERATION_RETRIES=2
# Extra attempts for transient transport failures (connection, timeout, 429, 5xx).
MAX_TRANSPORT_RETRIES=2
MAX_RETRY_BACKOFF_SECONDS=8
# Hard wall-clock limit for one request, including all retries (seconds).
REQUEST_DEADLINE_SECONDS=300

DEFAULT_TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=2048

# true: unexpected fields in model output are a validation failure (retried).
# false: unknown fields are dropped before validation.
STRICT_SCHEMA=true

LOG_LEVEL=INFO
