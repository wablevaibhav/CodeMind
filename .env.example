# CodeMind configuration. Copy to .env and adjust. Never commit a real .env.
# Every setting is optional: the defaults below work with a standard local Ollama.

# Where Ollama listens. Inference stays on this machine by default.
# On Windows, 127.0.0.1 connects faster than "localhost" (which can try IPv6 first).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model used when a request does not name one. It must already be installed:
#   ollama pull qwen2.5-coder:3b
# 3b fits entirely on a 4 GB GPU and answers in ~5 s. Bigger models are smarter but slower
# unless you have a large GPU: qwen2.5-coder:7b (needs ~8 GB VRAM for full speed),
# qwen2.5-coder:14b (~12 GB VRAM). Smaller/faster: qwen2.5-coder:1.5b (lower quality).
OLLAMA_MODEL=qwen2.5-coder:3b

# Per-call HTTP timeout to Ollama (seconds). Raise for big models on slow hardware.
OLLAMA_TIMEOUT_SECONDS=120
# Context window requested from Ollama (Ollama's own default of 2048 silently truncates prompts).
OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model in memory after a request (avoids slow reloads).
OLLAMA_KEEP_ALIVE=30m
# Load the selected model into memory when the API starts so the first answer is fast.
# (Never downloads anything.)
WARMUP_ON_START=true

# Extra attempts after an invalid model response (regenerate / repair). 0 disables.
MAX_GENERATION_RETRIES=2
# Extra attempts for transient transport failures (connection, timeout, 429, 5xx).
MAX_TRANSPORT_RETRIES=2
MAX_RETRY_BACKOFF_SECONDS=8
# Hard wall-clock limit for one request, including all retries (seconds).
REQUEST_DEADLINE_SECONDS=300

DEFAULT_TEMPERATURE=0.2
# Upper bound on generated tokens. Lower = faster worst case. Truncated JSON is invalid,
# so keep this comfortably above your typical answer length.
MAX_OUTPUT_TOKENS=1024

# true: unexpected fields in model output are a validation failure (retried).
# false: unknown fields are dropped before validation.
STRICT_SCHEMA=true

LOG_LEVEL=INFO
